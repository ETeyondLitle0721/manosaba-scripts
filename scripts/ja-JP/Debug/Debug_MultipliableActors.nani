@Gosub Path:System/System_Subroutine.BeginAdv

@ModifyBackgroundExtended TintColor:#000000 Duration:0 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

; @gosub .Characters
@Gosub Path:.Background

@Stop

; ==============================================================================
; キャラクター
; ==============================================================================

# Characters

[PrintTextModified Text:"Debug_MultipliableActors # Characters|#~3ca14d2a|" RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false ScenePosition:50,50 IdAndAppearance:Ema
@ModifyCharacterExtended Lazy:false ScenePosition:25,50 IdAndAppearance:Ema SubId:Sub1
@ModifyCharacterExtended Lazy:false ScenePosition:75,50 IdAndAppearance:Ema SubId:Sub2
@WaitForInput

@Return

; ==============================================================================
; 背景
; ==============================================================================

# Background

[PrintTextModified Text:"Debug_MultipliableActors # Background|#~7db468f4|" RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyBackgroundExtended Lazy:false ScenePosition:50,0 AppearanceAndTransition:Hall
@ModifyBackgroundExtended Lazy:false ScenePosition:0,50 AppearanceAndTransition:Hall SubId:Sub1
@ModifyBackgroundExtended Lazy:false ScenePosition:100,100 AppearanceAndTransition:Hall SubId:Sub2
@WaitForInput

@Return

