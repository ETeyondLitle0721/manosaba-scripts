[PrintTextModified Text:"あまりに<ruby=\"まばゆ\">眩</ruby>い光に看守は動きを止め、<br>メルルは目を細めた。|#0105Adv09_Narrative080|" RevealSpeed:1 WaitForInput:true Wait:true]

