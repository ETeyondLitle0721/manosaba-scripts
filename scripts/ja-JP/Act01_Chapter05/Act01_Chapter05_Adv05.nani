[PrintTextModified Text:残された時間内で周辺を捜索していると――|#0105Adv05_Narrative001| RevealSpeed:1 WaitForInput:true Wait:true]

; 荘厳な鐘の音
@PlaySfxModified SfxPath:Sfx_33 Volume:1 Loop:false FadeInDuration:0

