[PrintTextModified Text:"聞き覚えのある<ruby=\"はかな\">儚</ruby>い声に、<br>私は<ruby=\"ぼうぜん\">呆然</ruby>と立ち上がる。|#0204Adv15_Narrative015|" RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false IdAndAppearance:Hiro.Angry1,ArmR13,ArmL13

