@GosubResetWitchBook Path:System/System_ResetWitchBook IsDebugDirectJump:{isDebugDirectJump}
@Gosub Path:System/System_Subroutine.BeginAdv

@ModifyBackgroundExtended TintColor:#000000 Duration:1.2 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

# Scene2-4-3

; ========================================
; ●シーン2‐4‐3
; ========================================

; ========================================
; 用分岐
; ========================================

; ========================================
; 【ＭＡＰイベント】牢屋敷マップ
; ノアのアトリエ＞シーン2‐4‐4
; 湖方面＞シーン2‐4‐5
; 塀の前＞シーン2‐4‐6
; 花畑方面＞シーン2-4-7
; 水精の間＞シーン2‐4‐8
; ※全てのＭＡＰイベントを選択したら終了。
; 選択済みの場所は消していってください。
; ========================================

@BeginIf Expression:"chosenAreaFlag == 31"
    @SetCustomVariable Expression:"chosenAreaFlag = 0"
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter04/Act02_Chapter04_Adv09 SoftReset:true

@ChoiceMapArea CategoryNames:NoahStudio,Lake,Wall,FlowerFields,ChamberUndine Back:false Global:false MapAreaNames:NoahStudio,Lake,Wall,FlowerFields,ChamberUndine FlagVariableName:chosenAreaFlag

@BeginIf Expression:"chosenAreaId==\"NoahStudio\""
    @SetCustomVariableAsFlag Number:0 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter04/Act02_Chapter04_Adv04 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"Lake\""
    @SetCustomVariableAsFlag Number:1 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter04/Act02_Chapter04_Adv05 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"Wall\""
    @SetCustomVariableAsFlag Number:2 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter04/Act02_Chapter04_Adv06 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"FlowerFields\""
    @SetCustomVariableAsFlag Number:3 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter04/Act02_Chapter04_Adv07 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"ChamberUndine\""
    @SetCustomVariableAsFlag Number:4 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter04/Act02_Chapter04_Adv08 SoftReset:true

@Stop

