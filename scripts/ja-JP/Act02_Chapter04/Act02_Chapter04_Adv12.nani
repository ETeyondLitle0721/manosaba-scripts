[PrintTextModified Text:そこには――|#0204Adv12_Narrative090| RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:"<ruby=\"ちまみ\">血塗</ruby>れで倒れている、少女の死体があった。|#0204Adv12_Narrative091|" RevealSpeed:1 WaitForInput:true Wait:true]

