@ModifyBackgroundExtended Lazy:false AppearanceAndTransition:31_4

[PrintTextModified Text:"半地下に出ると、<br>エレベーターの横に<ruby=\"きゃたつ\">脚立</ruby>があることに気付く。|#0204Adv12_Narrative088|" RevealSpeed:1 WaitForInput:true Wait:true]

