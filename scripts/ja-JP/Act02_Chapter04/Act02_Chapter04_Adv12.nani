@Wait WaitMode:1.2

[PrintTextModified Text:"ちょうど良いとその<ruby=\"きゃたつ\">脚立</ruby>をエレベーターに持ち込み、<br>私は天井穴から顔を出した。|#0204Adv12_Narrative089|" RevealSpeed:1 WaitForInput:true Wait:true]

