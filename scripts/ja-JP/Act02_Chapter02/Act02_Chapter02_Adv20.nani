[PrintTextModified Text:"照れたように、ノアが<ruby=\"ほお\">頬</ruby>をかく。|#0202Adv20_Narrative007|" RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false IdAndAppearance:AnAn.Pensive1

