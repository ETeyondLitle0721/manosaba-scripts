@ModifyPerspectiveStageCamera Index:0 Height:5.6 Rotation:"0,{ (8 / courtStandCount * 360)},0" Distance:12 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:0 Rotation:"0,{ (8.1 / courtStandCount * 360)},0" Duration:1 EaseName:OutQuad
