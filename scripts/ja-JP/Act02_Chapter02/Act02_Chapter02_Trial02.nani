@ModifyCharacterExtended Duration:0 Lazy:false IdAndAppearance:Ema.Angry1
@ModifyPerspectiveStageCamera Index:0 Height:5.6 Rotation:"0,{ (0 / courtStandCount * 360)},0" Distance:12 Duration:0
@WaitForNextFrame

