[PrintTextModified Text:なっ！？|#0202Adv14_Hiro016| AuthorId:Hiro RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:"銃声のような音が響くと同時に、<br>赤黒い<ruby=\"しぶき\">飛沫</ruby>が画面を汚した。|#0202Adv14_Narrative024|" RevealSpeed:1 WaitForInput:true Wait:true]

