@HideActors ActorIds:Ema-Front Lazy:false
@DestroySpawnedExtended Path:MaskingRectangle SubId:Front LogWarning:true

[PrintTextModified Text:うん……。|#0203Adv14_Noah001| AuthorId:Noah RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:"ノアは寂しそうに<ruby=\"うつむ\">俯</ruby>いて、<br>その時のことを語りだした。|#0203Adv14_Narrative006|" RevealSpeed:1 WaitForInput:true Wait:true]

