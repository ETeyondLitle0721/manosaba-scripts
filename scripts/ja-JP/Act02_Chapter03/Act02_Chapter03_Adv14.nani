[PrintTextModified Text:"正しさが見つからないまま、<br>私たちはノアを<ruby=\"さば\">裁</ruby>かなくてはならない。|#0203Adv14_Narrative056|" RevealSpeed:1 WaitForInput:true Wait:true]

