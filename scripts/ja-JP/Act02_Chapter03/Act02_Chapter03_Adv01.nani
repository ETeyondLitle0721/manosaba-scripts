[PrintTextModified Text:"わわわ、私の名前は、ひっ、ひっ、ひ……<br><ruby=\"ひかみ\">氷上</ruby>、メルル、です……っ|#0203Adv01_Meruru001|" AuthorId:Meruru RevealSpeed:1 WaitForInput:true Wait:true]

