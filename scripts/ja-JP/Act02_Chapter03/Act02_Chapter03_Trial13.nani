@GosubResetWitchBook Path:System/System_ResetWitchBook Version:5

@BeginIf Expression:isDebugDirectJump
    @Gosub Path:Act02_Chapter03/Act02_Chapter03_TrialInit
    @HidePerspectiveStageScreen Index:1 Duration:0 Reset:true
    @ModifyBackgroundExtended TintColor:#000000 Duration:0 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

@SetTrialTimer Time:900
@HideUI UINames:ControlPanel AllowToggle:false
@ShowUI UINames:DebateUI

; ==============================================================================
; MARK: 8-13: 💬 ノアの告発
; ==============================================================================
; ＠ト書き▼議論シーン8-13 ノアの告発
; 議論開始エフェクト
; BGM変更：Guil-me N'o sinruits-Vocal有-
@PlayBgm BgmPath:Bgm_8_1 Volume:1 Loop:true FadeInDuration:0
; ボス演出
@ResetText
@ModifyCharacterExtended Duration:0 Lazy:false IdAndAppearance:Hiro.Normal2,ArmR6,ArmL3,Eyes2_Angry_Open2,Mouth2_Determined_Open2
@ModifyPerspectiveStageCamera Index:1 Height:5.6 Rotation:"0,{ (8 / courtStandCount * 360)},0" Distance:12 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:1 Rotation:"0,{ (8.1 / courtStandCount * 360)},0" Duration:1 EaseName:OutQuad
@ShowPerspectiveStageScreen Index:1
@Wait WaitMode:1.5

@ResetText
@ModifyCharacterExtended Duration:0 Lazy:false IdAndAppearance:Noah.Default,ArmR1,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open,Angle01/Facial/Mouth>Mouth_Smile_Open02
@ModifyPerspectiveStageCamera Index:0 Height:5.6 Rotation:"0,{ (7 / courtStandCount * 360)},0" Distance:12 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:0 Rotation:"0,{ (6.9 / courtStandCount * 360)},0" Duration:1 EaseName:OutQuad
@HidePerspectiveStageScreen Index:1 Reset:true
@Wait WaitMode:1.5

# Judge8-13-1

@Gosub Path:System/System_Subroutine.BeginDebate-First
@Gosub Path:System/System_Subroutine.BeginDebate-Effect
@Gosub Path:System/System_Subroutine.BeginDebate-Last
@ChangeTrialPauseMode Enable:false ProcessTimer:true

@HidePerspectiveStageScreen Index:1 Reset:true

@ModifyCharacterExtended Lazy:false IdAndAppearance:Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open_1,Angle01/Facial/Mouth>Mouth_Confused_Open
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Noah Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"のあね、<br>図書室から出たときに<br>エマちゃんと<br>ヒロちゃんを<link=\"Objection_02_03_13_01\">見た</link>んだ。|#0203Trial13_Noah001|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Noah.Default,ArmR5,ArmL2,Angle01/Facial/Eyes>Eyes_Surprised_Open02,Angle01/Facial/Mouth>Mouth_Surprised_Open02,Angle01/Facial/Pale>Pale01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Noah Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"ヒロちゃんがアンアンちゃんを<br>突き落としてるところ、<br><link=\"Objection_02_03_13_02\">ちょうど見ちゃった</link>の。|#0203Trial13_Noah002|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Noah.Pensive1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open_1,Angle01/Facial/Mouth>Mouth_Surprised_Open01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Noah Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:でものあ、<br>怖くなって<br>逃げだしちゃった……。|#0203Trial13_Noah003| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Noah.Cry1,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Confused_Open
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Noah Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:こんなこと言ったら、<br>のあも殺されちゃうと<br>思ったから……<br>それからずっと<br>黙ってたんだ。|#0203Trial13_Noah004| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmR7,ArmL13,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Scream_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Ema Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:で、でもノアちゃん！|#0203Trial13_Ema001| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Surprised_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Confused_Open,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Ema Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:現場には<br>アンアンちゃんが<br>自作自演をしようとしてた<br>痕跡が残ってたんだ……！|#0203Trial13_Ema002| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Angry_Open01,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle,Angle01/Head01/Facial01/Sweat01>Sweat01_01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Ema Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:ヒロちゃんが<br>アンアンちゃんを<br>殺していないのは、<br>客観的な事実だよ……！|#0203Trial13_Ema003| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Noah.Angry1,ArmR5,ArmL2
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Noah Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"そんなの、<br><link=\"Objection_02_03_13_03\">ヒロちゃんとエマちゃんが</link><br>あとから偽の証拠を作って<br>でっちあげたんじゃ<br>ないかな？|#0203Trial13_Noah005|" RevealSpeed:1 ScenePosition:68,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open02
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Noah Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"アンアンちゃんを<br>殺したあとで<br>中庭に細工をして、<br>そのあと<br><link=\"Objection_02_03_13_04\">偶然雨が降った</link>なら<br>成り立つよね？|#0203Trial13_Noah006|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Noah.Default,ArmR2,ArmL2,Angle01/Facial/Eyes>Eyes_Smile_Closed01,Angle01/Facial/Mouth>Mouth_Smile_Open01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Noah Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"エマちゃんとヒロちゃんは、<br><link=\"Objection_02_03_13_05\">共犯関係</link>なんだよ……。|#0203Trial13_Noah007|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Noah.Default,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Surprised_Open01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Noah Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"だからのあに<br>殺人の罪を<link=\"Objection_02_03_13_06\">押し付けて</link>、<br>処刑しちゃおうと<br>してるんだね。|#0203Trial13_Noah008|" RevealSpeed:1 ScenePosition:70,50 Roll:4

