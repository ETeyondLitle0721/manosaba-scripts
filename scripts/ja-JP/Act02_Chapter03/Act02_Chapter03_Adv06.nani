[PrintTextModified Text:ほとんど何も書いてないように見えるが？|#0203Adv06_Hiro021| AuthorId:Hiro RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false ScenePosition:50,30 IdAndAppearance:AnAn.Angry1
