@ModifyCharacterExtended Lazy:false IdAndAppearance:AnAn.Pensive

[PrintTextModified Text:それは……。|#0203Adv06_AnAn014| AuthorId:AnAn RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:"ノアの疑問に、アンアンは言葉を<ruby=\"つ\">詰</ruby>まらせる。|#0203Adv06_Narrative024|" RevealSpeed:1 WaitForInput:true Wait:true]

@HideAllCharacters Lazy:false

