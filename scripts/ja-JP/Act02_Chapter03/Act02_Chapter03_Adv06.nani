@ModifyCharacterExtended Lazy:false IdAndAppearance:AnAn

[PrintTextModified Text:……エマがウェンディ役なのが良くない。|#0203Adv06_AnAn013| AuthorId:AnAn RevealSpeed:1 WaitForInput:true Wait:true]

@HideAllCharacters Lazy:false
@ModifyCharacterExtended Lazy:false ScenePosition:30 IdAndAppearance:AnAn
@ModifyCharacterExtended Lazy:false ScenePosition:70 IdAndAppearance:Noah.Pensive1

