[PrintTextModified Text:"部屋の中が荒れ果てている。<br>中では、エマとアンアンが<ruby=\"も\">揉</ruby>み合っていた。|#0203Adv10_Narrative009|" RevealSpeed:1 WaitForInput:true Wait:true]

