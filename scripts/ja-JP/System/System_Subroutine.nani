    @SetCustomVariable Expression:"hannaPositionX = Sin(hannaIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetX"
    @SetCustomVariable Expression:"hannaPositionZ = Cos(hannaIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetZ"
