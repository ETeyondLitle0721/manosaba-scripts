@BeginIf Expression:"yukiIdx >= 0"
    @SetCustomVariable Expression:"yukiPositionX = Sin(yukiIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetX"
    @SetCustomVariable Expression:"yukiPositionZ = Cos(yukiIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetZ"
    @SetCustomVariable Expression:"yukiRotationY = 360 /{courtStandCount} * yukiIdx"
    @ModifyCharacterExtended Position:{yukiPositionX},{characterPositionY},{yukiPositionZ} Rotation:,{yukiRotationY} Scale:{characterScale},{characterScale},1 Duration:0 Lazy:false IdAndAppearance:Yuki.2

@BeginIf Expression:"wardenIdx >= 0"
    @SetCustomVariable Expression:"wardenPositionX = Sin(wardenIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetX"
    @SetCustomVariable Expression:"wardenPositionZ = Cos(wardenIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetZ"
    @SetCustomVariable Expression:"wardenRotationY = 360 /{courtStandCount} * wardenIdx"
    @ModifyCharacterExtended Position:{wardenPositionX},{characterPositionY},{wardenPositionZ} Rotation:,{wardenRotationY} Scale:{characterScale},{characterScale},1 Duration:0 Lazy:false IdAndAppearance:Warden.1

@BeginIf Expression:"jailerIdx >= 0"
    @SetCustomVariable Expression:"jailerPositionX = Sin(jailerIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetX"
    @SetCustomVariable Expression:"jailerPositionZ = Cos(jailerIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetZ"
    @SetCustomVariable Expression:"jailerRotationY = 360 /{courtStandCount} * jailerIdx"
    @ModifyCharacterExtended Position:{jailerPositionX},{characterPositionY},{jailerPositionZ} Rotation:,{jailerRotationY} Scale:{characterScale},{characterScale},1 Duration:0 Lazy:false IdAndAppearance:Jailer.1

@SetCustomVariable Expression:"currentHp = maxHp"

@ShowPerspectiveStageScreen Index:0 Duration:0
@ShowPerspectiveStageScreen Index:1 Duration:0

@LoadPerspectiveStage Id:{stageName} Wait:true

@WaitForNextFrame

@BeginIf Expression:enableDebugSkip
    @Skip Enable:true

@Return

; ==============================================================================
; MARK: ⚖️ EndTrial: 裁判終了
; ==============================================================================

# EndTrial

@ProcessInput InputEnabled:true SetEnabled:Continue.true,Pause.false,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.false,ToggleUI.false,ShowBacklog.false,Rollback.false
@StopBgm
@HideUI UINames:ControlPanel,AutoToggle,WitchBookButtonUI,DebateUI AllowToggle:false
@ResetText
@ModifyBackgroundExtended TintColor:#000000 Duration:{g_fadeDurationAtScenarioTransition} Lazy:false AppearanceAndTransition:SolidColor SubId:Overlay
@Wait WaitMode:{g_fadeDurationAtScenarioTransition}

@HideAllCharacters Duration:0 Lazy:false
@HidePerspectiveStageScreen Index:0 Duration:0 Reset:true
@HidePerspectiveStageScreen Index:1 Duration:0 Reset:true
@UnloadPerspectiveStage

@Return

; ==============================================================================
; MARK: ⚖️ BeginDebate: 議論開始
; ==============================================================================

; 
; MARK: BeginDebate-First: 議論開始処理・前半
; ------------------------------------------------------------------------------

# BeginDebate-First

@ResetText
@HidePrinter
@HideUI UINames:AutoToggle AllowToggle:false

@Return

; 
; MARK: BeginDebate-Effect: 議論開始エフェクト
; ------------------------------------------------------------------------------

# BeginDebate-Effect

@ProcessInput InputEnabled:true SetEnabled:Continue.true,Pause.false,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.false,ToggleUI.false,ShowBacklog.false,Rollback.false
@HideUI UINames:WitchBookButtonUI AllowToggle:false
@SpawnExtended Path:BeginDebateText Wait:true
@DestroySpawnedExtended Path:BeginDebateText Wait:true LogWarning:true

@Return

; 
; MARK: BeginDebate-Last: 議論開始処理・後半
; ------------------------------------------------------------------------------

# BeginDebate-Last

@Skip Enable:false
@ProcessInput InputEnabled:true SetEnabled:Continue.{allowContinueDebate},Pause.false,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.false,ToggleUI.false,ShowBacklog.false,Rollback.{allowRollback}
@ShowUI UINames:WitchBookButtonUI
@ChangeDebateMode Enable:true

@Return

; ==============================================================================
; MARK: ⚖️ EndDebate: 議論終了
; ==============================================================================

; 
; MARK: EndDebate-First: 議論終了処理・前半
; ------------------------------------------------------------------------------

# EndDebate-First

@ChangeDebateMode Enable:false
@ResetText PrinterId:Debate
@HidePrinter PrinterId:Debate

@Return

; 
; MARK: EndDebate-Effect: 議論終了エフェクト
; ------------------------------------------------------------------------------

# EndDebate-Effect

@ProcessInput InputEnabled:true SetEnabled:Continue.true,Pause.false,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.false,ToggleUI.false,ShowBacklog.false,Rollback.false
@HideUI UINames:WitchBookButtonUI AllowToggle:false
@SpawnExtended Path:EndDebateText Wait:true
@DestroySpawnedExtended Path:EndDebateText Wait:true LogWarning:true

@Return

; 
; MARK: EndDebate-CutIn: 議論終了・反論カットイン
; ------------------------------------------------------------------------------

# EndDebate-CutIn

@Skip Enable:false
@ProcessInput InputEnabled:false
@HideUI UINames:WitchBookButtonUI AllowToggle:false

@BeginIf Expression:!enableDebugSkip
    @SpawnExtended Path:{objectionCutInSpawnPath} Params:{objectionCutInIndex} Wait:true
    @DestroySpawnedExtended Path:{objectionCutInSpawnPath} LogWarning:true

@Return

; 
; MARK: EndDebate-Last: 議論終了処理・後半
; ------------------------------------------------------------------------------

# EndDebate-Last

@Skip Enable:false
@ProcessInput InputEnabled:true SetEnabled:Continue.true,Pause.true,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.true,ToggleUI.{allowToggleUI},ShowBacklog.true,Rollback.{allowRollback}
@ShowUI UINames:AutoToggle,WitchBookButtonUI

@BeginIf Expression:enableDebugSkip
    @Skip Enable:true

@Return

; 
; MARK: AdditionalDebate-CutIn-2: 追加議論カットイン2
; ------------------------------------------------------------------------------

# AdditionalDebate-CutIn-2

@BeginIf Expression:!enableDebugSkip
    @Skip Enable:false
    @ProcessInput InputEnabled:false
    @HideUI UINames:ControlPanel,AutoToggle,WitchBookButtonUI AllowToggle:false
    @SpawnExtended Path:ObjectionCutIn_Ema Params:2 Wait:true
    @DestroySpawnedExtended Path:ObjectionCutIn_Ema LogWarning:true
    @ShowUI UINames:ControlPanel,AutoToggle,WitchBookButtonUI
    @ProcessInput InputEnabled:true

@Return

; 
; タイムアップ
; ------------------------------------------------------------------------------

# TimeIsUp

@Skip Enable:false
@Gosub Path:.EndDebate-First
@ProcessInput InputEnabled:false
@StopBgm
@ClearChoiceHandler HandlerId:* Hide:true
@HideUI UINames:ControlPanel,AutoToggle,WitchBookButtonUI,DebateUI AllowToggle:false
@SpawnExtended Path:TimeIsUpText Wait:true
@ModifyBackgroundExtended Duration:0.9 Lazy:false AppearanceAndTransition:SolidColor SubId:Overlay
@DestroySpawnedExtended Path:TimeIsUpText Wait:true LogWarning:true

@GotoModified Path:Common/CommonBad{commonBadEndId}

; ==============================================================================
; MARK: 🎥 ModifyCamera: ステージカメラ移動
; ModifyCamera-{Composition}-{Roll}-{ZoomLevel}
; ==============================================================================

# ModifyCamera-Center-NoRoll-Lvl1

@SetCustomVariable Expression:"cameraYaw ={targetCharIdx} /{courtStandCount} * 360"
@SetCustomVariable Expression:"cameraRoll = 0"
@ModifyPerspectiveStageCamera Index:{cameraIdx} Height:5.2 Rotation:0,{cameraYaw},{cameraRoll} Distance:10 Duration:0

@Return

