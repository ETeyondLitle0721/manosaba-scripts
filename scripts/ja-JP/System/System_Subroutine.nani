@BeginIf Expression:"alisaIdx >= 0"
    @SetCustomVariable Expression:"alisaPositionX = Sin(alisaIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetX"
    @SetCustomVariable Expression:"alisaPositionZ = Cos(alisaIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetZ"
    @SetCustomVariable Expression:"alisaRotationY = 360 /{courtStandCount} * alisaIdx"
