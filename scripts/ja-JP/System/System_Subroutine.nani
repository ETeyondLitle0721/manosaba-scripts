@Stop

; ==============================================================================
; MARK: 📖 BeginAdv: ADV 開始
; ==============================================================================

# BeginAdv

@BeginIf Expression:isDebugDirectJump
    @SetCustomVariable Expression:"hasWitchBook = true"

@SetCustomVariable Expression:"isDebugDirectJump = false"
@ProcessInput InputEnabled:true SetEnabled:Continue.true,Pause.true,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.true,ToggleUI.{allowToggleUI},ShowBacklog.true,Rollback.{allowRollback}
@ChangeTrialMode Enable:false
@ShowPrinter PrinterId:Normal Duration:0
@ShowUI UINames:ControlPanel,AutoToggle Duration:0

@BeginIf Expression:"hasWitchBook && !isReenact"
    @ShowUI UINames:WitchBookButtonUI Duration:0

@ModifyBackgroundExtended TintColor:#000000 Duration:0 Lazy:false AppearanceAndTransition:SolidColor SubId:Overlay
@WaitForNextFrame

@BeginIf Expression:enableDebugSkip
    @Skip Enable:true

@Return

; ==============================================================================
; MARK: 📖 EndAdv: ADV 終了
; ==============================================================================

# EndAdv

@ProcessInput InputEnabled:true SetEnabled:Continue.true,Pause.false,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.false,ToggleUI.false,ShowBacklog.false,Rollback.false
@StopBgm
@HideUI UINames:ControlPanel,AutoToggle,WitchBookButtonUI AllowToggle:false
@ResetText
@ModifyBackgroundExtended TintColor:#000000 Duration:{g_fadeDurationAtScenarioTransition} Lazy:false AppearanceAndTransition:SolidColor SubId:Overlay
@Wait WaitMode:{g_fadeDurationAtScenarioTransition}

@Return

; ==============================================================================
; MARK: ⚖️ BeginTrial: 裁判開始
; ==============================================================================

# BeginTrial

@BeginIf Expression:isDebugDirectJump
    @SetCustomVariable Expression:"hasWitchBook = true"

@SetCustomVariable Expression:"isDebugDirectJump = false"
@ProcessInput InputEnabled:false SetEnabled:Continue.true,Pause.true,Skip.true,ToggleSkip.true,SkipMovie.true,AutoPlay.true,ToggleUI.{allowToggleUI},ShowBacklog.true,Rollback.{allowRollback}
@ChangeTrialMode Enable:true
@ShowPrinter PrinterId:Normal Duration:0
@ShowUI UINames:ControlPanel,AutoToggle,WitchBookButtonUI Duration:0
@ModifyBackgroundExtended TintColor:#000000 Duration:0 Lazy:false AppearanceAndTransition:SolidColor SubId:Overlay

@SetCustomVariable Expression:"characterPositionY = stageOffsetY + 5"
@SetCustomVariable Expression:"hiddenCharacterPositionY = characterPositionY - 100"
@SetCustomVariable Expression:"characterScale = 0.25"
@SetCustomVariable Expression:"characterDistance = 16"

@BeginIf Expression:"emaIdx >= 0"
    @SetCustomVariable Expression:"emaPositionX = Sin(emaIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetX"
    @SetCustomVariable Expression:"emaPositionZ = Cos(emaIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetZ"
    @SetCustomVariable Expression:"emaRotationY = 360 /{courtStandCount} * emaIdx"
    @ModifyCharacterExtended Position:{emaPositionX},{characterPositionY},{emaPositionZ} Rotation:,{emaRotationY} Scale:{characterScale},{characterScale},1 Duration:0 Lazy:false IdAndAppearance:Ema.Default

