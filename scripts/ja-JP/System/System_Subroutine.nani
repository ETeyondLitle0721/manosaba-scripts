    @SetCustomVariable Expression:"noahPositionZ = Cos(noahIdx * g_pi * 2 /{courtStandCount}) * characterDistance + stageOffsetZ"
    @SetCustomVariable Expression:"noahRotationY = 360 /{courtStandCount} * noahIdx"
    @ModifyCharacterExtended Position:{noahPositionX},{characterPositionY},{noahPositionZ} Rotation:,{noahRotationY} Scale:{characterScale},{characterScale},1 Duration:0 Lazy:false IdAndAppearance:Noah.Default

