; ==============================================================================
; MARK: 🎥 SplitScreen: ステージ画面分割
; SplitScreen-{Composition}-{Roll}
; ==============================================================================

# SplitScreen-Left-Right

@SetCustomVariable Expression:"cameraYaw = ({targetCharIdx} + 0.25) /{courtStandCount} * 360"
@ModifyPerspectiveStageCamera Index:{cameraIdx} Height:5.2 Rotation:-3,{cameraYaw},5 Distance:10 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:{cameraIdx} Rotation:-1 Duration:0.6 EaseName:OutQuad
@SplitPerspectiveStageScreen Index:{cameraIdx} ScenePositionX:25 Roll:10 SplitDirection:Left
@ShowPerspectiveStageScreen Index:{cameraIdx}

@Return

; 左右反転Ver
# SplitScreen-Right-Left

@SetCustomVariable Expression:"cameraYaw = ({targetCharIdx} - 0.25) /{courtStandCount} * 360"
@ModifyPerspectiveStageCamera Index:{cameraIdx} Height:5.2 Rotation:-3,{cameraYaw},-5 Distance:10 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:{cameraIdx} Rotation:-1 Duration:0.6 EaseName:OutQuad
@SplitPerspectiveStageScreen Index:{cameraIdx} ScenePositionX:75 Roll:-10 SplitDirection:Right
@ShowPerspectiveStageScreen Index:{cameraIdx}

@Return

; 左カットイン
# SplitScreen-Left-Over

@SetCustomVariable Expression:"cameraYaw = ({targetCharIdx} + 0.25) /{courtStandCount} * 360"
@ModifyPerspectiveStageCamera Index:{cameraIdx} Height:5.2 Rotation:0,{cameraYaw},5 Distance:10 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:{cameraIdx} Rotation:-1 Duration:0.6 EaseName:OutQuad
@SplitPerspectiveStageScreen Index:{cameraIdx} ScenePositionX:35 Roll:10 SplitDirection:Left
@ShowPerspectiveStageScreen Index:{cameraIdx}

@Return

; 右カットイン
# SplitScreen-Right-Over

@SetCustomVariable Expression:"cameraYaw = ({targetCharIdx} - 0.22) /{courtStandCount} * 360"
@ModifyPerspectiveStageCamera Index:{cameraIdx} Height:5.2 Rotation:0,{cameraYaw},-5 Distance:10 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:{cameraIdx} Rotation:-5 Duration:0.6 EaseName:OutQuad
@SplitPerspectiveStageScreen Index:{cameraIdx} ScenePositionX:65 Roll:10 SplitDirection:Right
@ShowPerspectiveStageScreen Index:{cameraIdx}

@Return

; 中央切断カットイン-Right
# SplitScreen-Right-Center

@SetCustomVariable Expression:"cameraYaw = ({targetCharIdx} - 0.2) /{courtStandCount} * 360"
@ModifyPerspectiveStageCamera Index:{cameraIdx} Height:5.2 Rotation:0,{cameraYaw},0 Distance:10 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:{cameraIdx} Rotation:0 Duration:0.6 EaseName:OutQuad
@SplitPerspectiveStageScreen Index:{cameraIdx} ScenePositionX:50 Roll:10 SplitDirection:Right
@ShowPerspectiveStageScreen Index:{cameraIdx}

@Return

