[PrintTextModified Text:"アリサさん、ですよね。<br>どうしてマスクを？ 顔を見られるとマズいんですか？|#0101Adv04_Sherry006|" AuthorId:Sherry RevealSpeed:1 WaitForInput:true Wait:true]

