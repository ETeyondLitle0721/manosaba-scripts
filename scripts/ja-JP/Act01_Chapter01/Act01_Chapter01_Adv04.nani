@HideAllCharacters Lazy:false
@ModifyCharacterExtended Lazy:false ScenePosition:50 IdAndAppearance:Sherry.Surprised1,ArmR7

[PrintTextModified Text:あっ、それ、私も思いました！<br>有名人の方でしょうか！？|#0101Adv04_Sherry004| AuthorId:Sherry RevealSpeed:1 WaitForInput:true Wait:true]

