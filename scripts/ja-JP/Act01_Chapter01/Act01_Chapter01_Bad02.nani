@ModifyCharacterExtended Lazy:false ScenePosition:50 IdAndAppearance:Ema.Pensive1 SubId:Middle

[PrintTextModified Text:"開けてよ！ なんでボクを閉じ込めるの！？|#0101Bad02_Ema014|" AuthorId:Ema RevealSpeed:1 WaitForInput:true Wait:true]

