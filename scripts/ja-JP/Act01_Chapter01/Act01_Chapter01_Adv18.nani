[PrintTextModified Text:"マップで見た感じ、<br>ここは【<ruby=\"サラマンダー\">火精</ruby>の間】……？|#0101Adv18_Ema007|" AuthorId:Ema RevealSpeed:1 WaitForInput:true Wait:true]

