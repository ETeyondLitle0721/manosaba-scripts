[PrintTextModified Text:"エマとレイアの目が合う。<br>レイアがにっこりと<ruby=\"ほほえ\">微笑</ruby>んだことで、<br>エマは<ruby=\"ほお\">頬</ruby>を染め、慌てて目を<ruby=\"そ\">逸</ruby>らした。|#0101Adv08_Narrative015|" RevealSpeed:1 WaitForInput:true Wait:true]

