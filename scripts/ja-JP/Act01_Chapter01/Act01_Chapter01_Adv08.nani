[PrintTextModified Text:あ……あ……。|#0101Adv08_Hanna008| AuthorId:Hanna RevealSpeed:1 WaitForInput:true Wait:true]

@HideAllCharacters Lazy:false
@ModifyCharacterExtended Lazy:false ScenePosition:50 IdAndAppearance:Sherry.Smile1,ArmR8

[PrintTextModified Text:ちょっと力が強いかなってくらいで。|#0101Adv08_Sherry010| AuthorId:Sherry RevealSpeed:1 WaitForInput:true Wait:true]

@HideAllCharacters Lazy:false

[PrintTextModified Text:"ハンナも、エマも、<ruby=\"あぜん\">唖然</ruby>としている。|#0101Adv08_Narrative026|" RevealSpeed:1 WaitForInput:true Wait:true]

