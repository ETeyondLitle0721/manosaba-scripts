@PlaySfxModified SfxPath:Sfx_1 Volume:1 Loop:false FadeInDuration:0
@ModifyBackgroundExtended Id:Stills Rotation:,,-10 Scale:"{g_backgroundDefaultScale * 3}" Lazy:false ScenePosition:80,-35 AppearanceAndTransition:490_1 SubId:Middle
