@GosubResetWitchBook Path:System/System_ResetWitchBook Version:2

@BeginIf Expression:isDebugDirectJump
    @Gosub Path:Act01_Chapter01/Act01_Chapter01_TrialInit
    @HidePerspectiveStageScreen Index:1 Duration:0 Reset:true
    @ModifyBackgroundExtended TintColor:#000000 Duration:0 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

@SetTrialTimer Time:900
@HideUI UINames:ControlPanel AllowToggle:false
@ShowUI UINames:DebateUI

; ==============================================================================
; MARK: 9: 💬 ノアが殺害された方法
; ==============================================================================
; ＠ト書き▼議論シーン1-9 ノアが殺害された方法
; BGM変更：AccUhEarts(Vocal無)
@PlayBgm BgmPath:Bgm_15_1 Volume:1 Loop:true FadeInDuration:0

# Judge1-9-1

@Gosub Path:System/System_Subroutine.BeginDebate-First
@Gosub Path:System/System_Subroutine.BeginDebate-Effect
@Gosub Path:System/System_Subroutine.BeginDebate-Last
@ChangeTrialPauseMode Enable:false ProcessTimer:true

@HidePerspectiveStageScreen Index:1 Reset:true

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Default
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:まず順番に<br>話を整理してみましょうか。<br>犯人が城ケ崎ノアの部屋を<br>訪れた所からよ。|#0101Trial09_Nanoka001| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Sherry.Normal1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Sherry Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"はい！<br>まず<link=\"Objection_01_01_09_01\">犯人が部屋を訪れた時</link>、<br>部屋は<link=\"Objection_01_01_09_02\">白い塗料</link>で<br>覆われていました。<br>それをしたのは<br><link=\"Objection_01_01_09_03\">ノアさん自身</link>ですよね。|#0101Trial09_Sherry001|" RevealSpeed:1 ScenePosition:37,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Leia.Smile1,ArmR3,ArmL5,Angle01/Facial/Eyes>Eyes_Smile_Open,Angle01/Facial/Mouth>Mouth_Smile_Middle
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Leia Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"……そうして<link=\"Objection_01_01_09_04\">空を飛んだ犯人</link>は、<br>被害者に近付いて<br><link=\"Objection_01_01_09_05\">手に持った矢</link>を<br>突き立てたわけだ。<br><link=\"Objection_01_01_09_06\">シンプル</link>な解法だ。<br>非の打ち所もない。|#0101Trial09_Leia001|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Hanna.Angry1,ArmR3,ArmL2
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Hanna Composition:Right RollDirection:Left ZoomLevel:4
@PrintDebateText Text:どうしても<br>わたくしを犯人扱い<br>したいようですわねっ！？<br>空中以外からも、<br>刺す方法はあったんじゃ<br>ないですこと！？|#0101Trial09_Hanna001| RevealSpeed:1 ScenePosition:35,45 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Margo.Smile1,ArmR2,ArmL5
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Margo Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"その場合、犯人は<link=\"Objection_01_01_09_07\">ダーツの達人</link>か、<br>もしくは腕の<br><link=\"Objection_01_01_09_08\">リーチを伸ばせた</link>か……。<br>それとも<link=\"Objection_01_01_09_09\">そんな魔法</link>に<br>心当たりでもあるのかしら？<br>まあそんなこと、<br>ありえないとは思うけど……。|#0101Trial09_Margo001|" RevealSpeed:1 ScenePosition:67,50 Roll:4

; ＠備考◆冗談に笑うように
@ModifyCharacterExtended Lazy:false IdAndAppearance:Miria.Smile1,ArmR3,ArmL4,Angle01/Facial/Eyes>Eyes_Pensive_Open01,Angle01/Facial/Mouth>Mouth_Smile_Open02
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Miria Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:ああ～、<br>ゲームや漫画の中でなら<br>そんな人に心当たりは<br>あるけれど……。<br>さすがにねぇ。|#0101Trial09_Miria001| RevealSpeed:1 ScenePosition:33,53 Roll:-4

