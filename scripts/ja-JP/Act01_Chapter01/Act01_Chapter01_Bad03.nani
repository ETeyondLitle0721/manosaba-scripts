[PrintTextModified Text:"理解の追いつかない状況に、<br>エマは<ruby=\"ぼうぜん\">呆然</ruby>としたまま動けなかった――|#0101Bad03_Narrative039|" RevealSpeed:1 WaitForInput:true Wait:true]

