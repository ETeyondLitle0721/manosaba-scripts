@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Surprised1,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open04,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Middle
[PrintTextModified Text:（メルルちゃん……！）|#0101Trial10_Ema002| AuthorId:Ema RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Normal1,ArmR9,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Normal_Closed
[PrintTextModified Text:"……うん！ 任せて！|#0101Trial10_Ema003|" AuthorId:Ema RevealSpeed:1 WaitForInput:true Wait:true]

@HidePerspectiveStageScreen Index:1 Reset:true Wait:true

