@Wait WaitMode:0.3

[PrintTextModified Text:"（勝手に動くって……<br>　それって、魔法、だよね？）|#0101Adv07_Ema012|" AuthorId:Ema RevealSpeed:1 WaitForInput:true Wait:true]

@ShowToastUI Text:"魔女図鑑 更新…|#Toast_001|"
