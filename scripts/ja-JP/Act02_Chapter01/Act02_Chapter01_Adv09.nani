[PrintTextModified Text:"<ruby=\"いげん\">威厳</ruby>のある声が響き、皆がハッとした。<br>看守の暴走に、ゴクチョーが現れ<ruby=\"いさ\">諫</ruby>めてくれたのだと思った。|#0201Adv09_Narrative043|" RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false ScenePosition:50 IdAndAppearance:Margo.Angry1

