[PrintTextModified Text:"定刻どおり、小さな<ruby=\"つうきこう\">通気口</ruby>から、<br>化け物フクロウが飛んできた。|#0201Adv04_Narrative031|" RevealSpeed:1 WaitForInput:true Wait:true]

