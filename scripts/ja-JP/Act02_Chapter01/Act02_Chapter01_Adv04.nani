@ModifyCharacterExtended Lazy:false ScenePosition:50 IdAndAppearance:Hiro.Normal1

[PrintTextModified Text:次ぃ！|#0201Adv04_Hiro021| AuthorId:Hiro RevealSpeed:1 WaitForInput:true Wait:true]

@HideAllCharacters Lazy:false
@ModifyCharacterExtended Lazy:false ScenePosition:70 IdAndAppearance:Miria.Surprised1

[PrintTextModified Text:"怖い！ お、おじさん、もう心が折れそうなんだけど……。|#0201Adv04_Miria001|" AuthorId:Miria RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false ScenePosition:30 IdAndAppearance:Hiro.Pensive1

[PrintTextModified Text:"おじさん？ いいから君の名前を名乗ってくれないか。|#0201Adv04_Hiro022|" AuthorId:Hiro RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false ScenePosition:70 IdAndAppearance:Miria.Pensive1

