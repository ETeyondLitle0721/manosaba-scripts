[PrintTextModified Text:あ……が……。|#0201Bad01_Alisa016| AuthorId:Alisa RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:"ナノカがアリサの頭部を<ruby=\"わしづか\">鷲掴</ruby>み、<br>握り潰したのだ。|#0201Bad01_Narrative109|" RevealSpeed:1 WaitForInput:true Wait:true]

