[PrintTextModified Text:"ナノカはぽつりと<ruby=\"つぶや\">呟</ruby>きを落として、<br>茂みの向こうへと消えていった。|#0201Adv16_Narrative022|" RevealSpeed:1 WaitForInput:true Wait:true]

