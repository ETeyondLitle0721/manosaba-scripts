[PrintTextModified Text:"私たちの出現に一瞬びくりと体を震わせたが、<br>取り<ruby=\"つくろ\">繕</ruby>うように笑顔になる。|#0201Adv16_Narrative027|" RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false ScenePosition:50 IdAndAppearance:Coco.Normal1

