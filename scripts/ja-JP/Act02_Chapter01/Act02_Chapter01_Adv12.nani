@GosubResetWitchBook Path:System/System_ResetWitchBook IsDebugDirectJump:{isDebugDirectJump}
@Gosub Path:System/System_Subroutine.BeginAdv

@ModifyBackgroundExtended TintColor:#000000 Duration:1.2 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

# Scene2-1-7

; ========================================
; ●シーン2‐1-7
; ========================================

; ========================================
; マップイベント用分岐
; ========================================

; ========================================
; 【ＭＡＰイベント】牢屋敷マップ
; 図書室＞シーン2‐1‐8
; 医務室＞シーン2‐1‐9
; 懲罰房＞シーン2‐1‐10
; 水精の間＞シーン2-1-11
; ？？？＞シーン2‐1‐12
; ※全てのＭＡＰイベントを選択したら終了。
; 選択済みの場所は消していってください。
; ========================================

@BeginIf Expression:"chosenAreaFlag == 31"
    @SetCustomVariable Expression:"chosenAreaFlag = 0"
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter01/Act02_Chapter01_Adv18 SoftReset:true

@ChoiceMapArea CategoryNames:Library,Infirmary,SolitaryConfinement,ChamberUndine,UnknownArea Back:false Global:false MapAreaNames:Library,Infirmary,SolitaryConfinement,ChamberUndine,UnknownArea FlagVariableName:chosenAreaFlag

@BeginIf Expression:"chosenAreaId==\"Library\""
    @SetCustomVariableAsFlag Number:0 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter01/Act02_Chapter01_Adv13 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"Infirmary\""
    @SetCustomVariableAsFlag Number:1 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter01/Act02_Chapter01_Adv14 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"SolitaryConfinement\""
    @SetCustomVariableAsFlag Number:2 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter01/Act02_Chapter01_Adv15 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"ChamberUndine\""
    @SetCustomVariableAsFlag Number:3 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter01/Act02_Chapter01_Adv16 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"UnknownArea\""
    @SetCustomVariableAsFlag Number:4 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter01/Act02_Chapter01_Adv17 SoftReset:true

@Stop

