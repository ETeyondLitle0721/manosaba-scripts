@ModifyCharacterExtended Scale:0.75 Lazy:false ScenePosition:70 IdAndAppearance:Coco.Pensive1

[PrintTextModified Text:ひっ……。|#0201Adv23_Miria001| AuthorId:Miria RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:コワ～。|#0201Adv23_Coco002| AuthorId:Coco RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:私は選ばれたのだ。|#0201Adv23_Narrative036| RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:この場にいる少女たちに、<br>私が殺人者――【魔女】であると。|#0201Adv23_Narrative037| RevealSpeed:1 WaitForInput:true Wait:true]

@HideAllCharacters Lazy:false

