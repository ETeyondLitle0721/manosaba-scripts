@ModifyCamera Offset:-5,0 Zoom:0.5 Duration:0 Lazy:false
@ModifyBackgroundExtended TintColor:#000000 Duration:1.2 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay
@Wait WaitMode:1.8

[PrintTextModified Text:"<ruby=\"のぞ\">覗</ruby>き窓があったので、<br>そこから中を<ruby=\"のぞ\">覗</ruby>いてみる。|#0201Adv15_Narrative002|" RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:……ここはどうやら懲罰房エリアのようだな。|#0201Adv15_Hiro001| AuthorId:Hiro RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:"懲罰房？ って何するところ？|#0201Adv15_Noah001|" AuthorId:Noah RevealSpeed:1 WaitForInput:true Wait:true]

[PrintTextModified Text:"ノアも私の隣に並んで中を<ruby=\"のぞ\">覗</ruby>いた。|#0201Adv15_Narrative003|" RevealSpeed:1 WaitForInput:true Wait:true]

