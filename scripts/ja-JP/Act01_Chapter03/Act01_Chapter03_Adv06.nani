@GosubResetWitchBook Path:System/System_ResetWitchBook IsDebugDirectJump:{isDebugDirectJump}
@Gosub Path:System/System_Subroutine.BeginAdv

@ModifyBackgroundExtended TintColor:#000000 Duration:1.2 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

# Scene1-3-6

; ========================================
; ●シーン1‐3-6
; ========================================

; ========================================
; マップイベント用分岐
; ========================================

; ========================================
; 【ＭＡＰイベント】牢屋敷マップ
; 玄関ホール＞シーン1‐3‐7
; ラウンジ＞シーン1‐3‐8
; 地下通路＞シーン1‐3‐9
; 娯楽室＞シーン1‐3‐10
; 図書室＞シーン1-3-11
; ※全てのＭＡＰイベントを選択したら終了。
; 選択済みの場所は消していってください。
; ========================================

@BeginIf Expression:"chosenAreaFlag == 31"
    @SetCustomVariable Expression:"chosenAreaFlag = 0"
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv12 SoftReset:true

@ChoiceMapArea CategoryNames:EntranceHall,Lounge,BasementHallway,RecreationRoom,Library Back:false Global:false MapAreaNames:EntranceHall,Lounge,BasementHallway,RecreationRoom,Library FlagVariableName:chosenAreaFlag

@BeginIf Expression:"chosenAreaId==\"EntranceHall\""
    @SetCustomVariableAsFlag Number:0 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv07 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"Lounge\""
    @SetCustomVariableAsFlag Number:1 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv08 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"BasementHallway\""
    @SetCustomVariableAsFlag Number:2 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv09 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"RecreationRoom\""
    @SetCustomVariableAsFlag Number:3 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv10 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"Library\""
    @SetCustomVariableAsFlag Number:4 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv11 SoftReset:true

@Stop

