[PrintTextModified Text:"シェリーが焼け死んでしまったことで、<br>永遠の<ruby=\"ろうごく\">牢獄</ruby>は開かなかった。|#0103Adv27_Narrative081|" RevealSpeed:1 WaitForInput:true Wait:true]

