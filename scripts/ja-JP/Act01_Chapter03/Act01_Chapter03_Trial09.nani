    @ModifyBackgroundExtended TintColor:#000000 Duration:0 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

@SetTrialTimer Time:900
@HideUI UINames:ControlPanel AllowToggle:false
@ShowUI UINames:DebateUI

@ModifyCharacterExtended Position:,{hiddenCharacterPositionY} Duration:0 Lazy:false IdAndAppearance:Warden.1
@ModifyCharacterExtended Position:,{hiddenCharacterPositionY} Duration:0 Lazy:false IdAndAppearance:Jailer.1
; ==============================================================================
; MARK: 3-9: 💬 昨夜起こった事
; ==============================================================================
; ＠ト書き▼議論3-9 昨夜起こった事
; カットイン
; BGM変更：AccUhEarts(Vocal無)
@PlayBgm BgmPath:Bgm_15_1 Volume:1 Loop:true FadeInDuration:0

# Judge3-9-1


@Gosub Path:System/System_Subroutine.BeginDebate-First
@Gosub Path:System/System_Subroutine.BeginDebate-Effect
@Gosub Path:System/System_Subroutine.BeginDebate-Last
@ChangeTrialPauseMode Enable:false ProcessTimer:true

@HidePerspectiveStageScreen Index:1 Reset:true

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Ema Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:昨夜、<br>マーゴちゃんたちが<br>出たあとで<br>ゲストハウスには<br>鍵がかけられた……。|#0103Trial09_Ema001| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmR8,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Ema Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:つまり、<br>部屋は３棟とも<br>密室状態だったってことで<br>いいんだよね？|#0103Trial09_Ema002| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Margo Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:ええ。<br>その通りよ。|#0103Trial09_Margo001| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Margo.Default,ArmR7,ArmL5,Angle01/Facial/Eyes>Eyes_Angry_Middle,Angle01/Facial/Mouth>Mouth_Neutral_Open
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Margo Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"そのとき部屋の中は<br><link=\"Objection_01_03_09_01\">荒れていなかった</link>し、<br><link=\"Objection_01_03_09_02\">死体もなかった</link>はずよ。|#0103Trial09_Margo002|" RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmR8,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Ema Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:そして夜に起こったのは<br>ナノカちゃんと<br>シェリーちゃんの<br>いざこざ……。<br>この時の破裂音は【１回】。<br>銃声だった。|#0103Trial09_Ema003| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.ArmR1,ArmL10,Eyes1_Normal_Open1,Mouth1_Normal_Open1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"……ええ。<br><link=\"Objection_01_03_09_03\">場所は倉庫</link>。<br>間違いないわ。|#0103Trial09_Nanoka001|" RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Ema Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:そしてその後……<br>アリサちゃんは<br>【２時】頃にも音を聞いた。<br>この内容は<br>まだ明らかになってないよね。|#0103Trial09_Ema004| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Meruru.Normal2,ArmR1_2,ArmL5,Eyes2_Normal_Open1,Mouth2_Surprised_Open2
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Meruru Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:そしてそれは、<br>地震だとは<br>考えにくい……<br>議論の結果は<br>そうなったはずです。|#0103Trial09_Meruru001| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Pensive_Open1,Mouth1_Normal_Open2
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Meruru Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"もし地震なら<br>水精の間も揺れて<br><link=\"Objection_01_03_09_04\">家具が倒れていた</link><br>でしょうし……。<br>結局密室については<br>わからないまま<br>ですね……。|#0103Trial09_Meruru002|" RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Sherry.Normal1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Sherry Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"いっそ【密室ではなかった】<br>というのはどうでしょう？<br>そもそも<br><link=\"Objection_01_03_09_05\">鍵</link>はちゃんと<br>かけられていたんでしょうか？<br>……実は<link=\"Objection_01_03_09_06\">ピッキング</link>で<br>開けられたとかありません？|#0103Trial09_Sherry001|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmR8,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Ema Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:でもそもそも朝の時点で<br>鍵はかかっていたはずだよ。<br>仮に犯人が鍵を開けて<br>侵入できたとしても……<br>鍵をかけ直す<br>必要があったんだ。|#0103Trial09_Ema005| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Coco.Normal1,ArmR3,ArmL2
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Coco Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:つか、それなら<br>部屋に細工されてた<br>可能性は？<br>もともとなんか<br>仕掛けがあったとかさー。|#0103Trial09_Coco001| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Alisa.Default,Angle01/Arms>Arms01,Angle01/ArmL-,Angle01/ArmR-,Angle01/Facial/Eyes>Eyes_Serious_Open
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Alisa Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"見つかってない<br><link=\"Objection_01_03_09_07\">隠し通路</link>が<br>あるってのか？<br>でも中はさんざん<br>調べたんだ。<br>部屋自体は<link=\"Objection_01_03_09_08\">普通の部屋</link><br>だったんだし。|#0103Trial09_Alisa001|" RevealSpeed:1 ScenePosition:32,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Margo.Smile1,ArmR2,ArmL5
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Margo Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"どうかしらね？<br><link=\"Objection_01_03_09_09\">昨夜の実験</link>で、<br>つながってはいけない<br>世界への道が<br>繋がってしまったのかも<br>しれないわ？|#0103Trial09_Margo003|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmR4,ArmL5,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Angry_Middle
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Ema Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:……ともかくそうして朝、<br>火事が起こって<br>死体は発見された。<br>火元は火精の間の<br>外だった……。|#0103Trial09_Ema006| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Alisa.Default,ArmR2,ArmL1,Angle01/Facial/Eyes>Eyes_Normal_Open01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Alisa Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"……ああ、間違いない。<br>調べたけど、<br>火事は<br><link=\"Objection_01_03_09_10\">外からの放火</link>だった。|#0103Trial09_Alisa002|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.ArmR3,ArmL1,Eyes1_Normal_Open2,Mouth1_Angry_Open1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"それによって私たちは<br>駆けつけた……。<br>……当然、事件後に<br>密室の中から<br><link=\"Objection_01_03_09_11\">出てきた人</link>は<br>いなかった。|#0103Trial09_Nanoka002|" RevealSpeed:1 ScenePosition:32,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.ArmR3,ArmL1,Eyes1_Normal_Open2,Mouth1_Angry_Open1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"……被害者である<br><br><link=\"Objection_01_03_09_12\">遠野ハンナ</link>を除けばね。|#0103Trial09_Nanoka003|" RevealSpeed:1 ScenePosition:30,50 Roll:-4

@Gosub Path:System/System_Subroutine.EndDebate-First
@ChangeTrialPauseMode Enable:true ProcessTimer:true
@Gosub Path:System/System_Subroutine.EndDebate-Effect
@Gosub Path:System/System_Subroutine.EndDebate-Last

