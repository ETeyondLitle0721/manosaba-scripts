@SetTrialTimer Time:900
@HideUI UINames:ControlPanel AllowToggle:false
@ShowUI UINames:DebateUI

@ModifyCharacterExtended Position:,{hiddenCharacterPositionY} Duration:0 Lazy:false IdAndAppearance:Warden.1
@ModifyCharacterExtended Position:,{hiddenCharacterPositionY} Duration:0 Lazy:false IdAndAppearance:Jailer.1
