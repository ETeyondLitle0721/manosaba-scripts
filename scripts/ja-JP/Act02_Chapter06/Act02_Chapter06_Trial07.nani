    @ModifyBackgroundExtended TintColor:#000000 Duration:0 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

@SetTrialTimer Time:900
@HideUI UINames:ControlPanel AllowToggle:false
@ShowUI UINames:DebateUI

; ==============================================================================
; MARK: 11-7: 💬 大魔女の動機
; ==============================================================================
; ＠ト書き▼議論11-7
; 議論開始カットイン
; BGM継続：AccUhEarts(Vocal無)
@PlayBgm BgmPath:Bgm_15_1 Volume:1 Loop:true FadeInDuration:0

# Judge11-7-1

@Gosub Path:System/System_Subroutine.BeginDebate-First
@Gosub Path:System/System_Subroutine.BeginDebate-Effect
@Gosub Path:System/System_Subroutine.BeginDebate-Last
@ChangeTrialPauseMode Enable:false ProcessTimer:true

@HidePerspectiveStageScreen Index:1 Reset:true

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.2
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:私たち魔女はこの孤島で<br>ひっそりと暮らしていました。|#0206Trial07_Yuki001| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.18
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:人間との交流もありましたが、<br>私たちは魔女同士の合議の上<br>人間たちには干渉しない選択を<br>とったんです。|#0206Trial07_Yuki002| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.4
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:人間たちは<br>魔法を使う私たちに<br>劣る種族……。<br>だからそれを見守るのが<br>私たちの役割であると<br>判断したからですね。|#0206Trial07_Yuki003| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.17
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:ですが……<br>それは間違った判断でした。|#0206Trial07_Yuki004| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.17
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:文明を発展させた人間たちが、<br>島を襲撃してきたのです。|#0206Trial07_Yuki005| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.13
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:私たちは島の中で防備を固め、<br>抵抗をしたものの……。|#0206Trial07_Yuki006| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.13
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"人質や毒物、騙し討ち……<br>人間たちは<br>さまざまな卑怯な手段を用いて<br>魔女を捕らえ、<br><link=\"Objection_02_06_07_01\">処刑</link>していきました。|#0206Trial07_Yuki007|" RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.14
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"その結果、<br>魔女たちは私を残し、<br>全員この世から<br><link=\"Objection_02_06_07_02\">消え去った</link>んです。|#0206Trial07_Yuki008|" RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.17
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:彼女たちは<br>無念だったでしょう。<br>悔しかったでしょう。|#0206Trial07_Yuki009| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.18
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"彼女たちの<br><link=\"Objection_02_06_07_03\">想いを知る者</link>は……<br>もう私しか残っていません。|#0206Trial07_Yuki010|" RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.13
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"私は<br><link=\"Objection_02_06_07_04\">死んでいった魔女たち</link>の<br>恨みを背負っています。|#0206Trial07_Yuki011|" RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.17
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:"だから<br>たとえ<link=\"Objection_02_06_07_05\">後ろ向き</link>で<br>あったとしても<br>私は止まれない……<br>止まっては、<br><link=\"Objection_02_06_07_06\">いけない</link>のです。|#0206Trial07_Yuki012|" RevealSpeed:1 ScenePosition:30,50 Roll:-4


@Gosub Path:System/System_Subroutine.EndDebate-First
@ChangeTrialPauseMode Enable:true ProcessTimer:true
@Gosub Path:System/System_Subroutine.EndDebate-Effect
@Gosub Path:System/System_Subroutine.EndDebate-Last

