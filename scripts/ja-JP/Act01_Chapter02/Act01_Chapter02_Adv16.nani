[PrintTextModified Text:"メルルが優しく背中を<ruby=\"な\">撫</ruby>でてやっているが、<br>アンアンはその場から、なかなか動かなかった。|#0102Adv16_Narrative037|" RevealSpeed:1 WaitForInput:true Wait:true]

