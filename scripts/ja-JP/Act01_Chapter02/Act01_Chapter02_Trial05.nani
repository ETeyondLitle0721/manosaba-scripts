@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Eyes1_Normal_Open1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
