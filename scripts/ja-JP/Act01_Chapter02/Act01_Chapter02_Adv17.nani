[PrintTextModified Text:"エマとシェリーは<ruby=\"うなず\">頷</ruby>き、<br>ハンナの後に続いて走り出した。|#0102Adv17_Narrative022|" RevealSpeed:1 WaitForInput:true Wait:true]

