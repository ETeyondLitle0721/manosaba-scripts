[PrintTextModified Text:"少女たちの悲痛な<ruby=\"おえつ\">嗚咽</ruby>や<ruby=\"どうこく\">慟哭</ruby>が、<br>地下通路に響く。|#0102Adv17_Narrative052|" RevealSpeed:1 WaitForInput:true Wait:true]

