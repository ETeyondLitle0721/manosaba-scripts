@GosubResetWitchBook Path:System/System_ResetWitchBook IsDebugDirectJump:{isDebugDirectJump}
@Gosub Path:System/System_Subroutine.BeginAdv

@ModifyBackgroundExtended TintColor:#000000 Duration:1.2 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

# Scene1-2-8

; ========================================
; ●シーン1‐2-8
; ========================================

; ========================================
; マップイベント用分岐
; ========================================

; ========================================
; 【ＭＡＰイベント】牢屋敷マップ
; 
; 地下通路＞シーン1‐2‐9
; ゲストハウス＞シーン1‐2‐10
; 娯楽室＞シーン1‐2‐11
; 湖方面＞シーン1‐2‐12
; シャワールーム＞1-2-13
; ※全てのＭＡＰイベントを選択したら終了。
; 選択済みの場所は消していってください。
; ========================================

@BeginIf Expression:"chosenAreaFlag == 31"
    @SetCustomVariable Expression:"chosenAreaFlag = 0"
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter02/Act01_Chapter02_Adv14 SoftReset:true

@ChoiceMapArea CategoryNames:BasementHallway,FrontGuesthouse,RecreationRoom,Lake,Showers Back:false Global:false MapAreaNames:BasementHallway,FrontGuesthouse,RecreationRoom,Lake,Showers FlagVariableName:chosenAreaFlag

@BeginIf Expression:"chosenAreaId==\"BasementHallway\""
    @SetCustomVariableAsFlag Number:0 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter02/Act01_Chapter02_Adv09 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"FrontGuesthouse\""
    @SetCustomVariableAsFlag Number:1 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter02/Act01_Chapter02_Adv10 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"RecreationRoom\""
    @SetCustomVariableAsFlag Number:2 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter02/Act01_Chapter02_Adv11 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"Lake\""
    @SetCustomVariableAsFlag Number:3 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter02/Act01_Chapter02_Adv12 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"Showers\""
    @SetCustomVariableAsFlag Number:4 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter02/Act01_Chapter02_Adv13 SoftReset:true

@Stop

