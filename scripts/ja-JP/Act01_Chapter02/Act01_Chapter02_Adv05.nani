@ModifyCharacterExtended Lazy:false ScenePosition:70 IdAndAppearance:Ema.Normal1,ArmR3

[PrintTextModified Text:アリサちゃん！<br>ちょうど良かった、探してたんだ！|#0102Adv05_Ema011| AuthorId:Ema RevealSpeed:1 WaitForInput:true Wait:true]

