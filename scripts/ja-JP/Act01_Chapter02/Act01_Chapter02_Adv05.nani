[PrintTextModified Text:"空気を裂く銃声が<ruby=\"とどろ\">轟</ruby>いた次の瞬間、<br>ミリアの足元に銃弾が刺さっていた。|#0102Adv05_Narrative034|" RevealSpeed:1 WaitForInput:true Wait:true]

