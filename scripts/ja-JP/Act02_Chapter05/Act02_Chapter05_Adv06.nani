[PrintTextModified Text:"帰れないなんて聞いてねーし！<br>やだ、やだやだやだ！！ 帰せよぉ！！|#0205Adv06_Coco001|" AuthorId:Coco RevealSpeed:1 WaitForInput:true Wait:true]

