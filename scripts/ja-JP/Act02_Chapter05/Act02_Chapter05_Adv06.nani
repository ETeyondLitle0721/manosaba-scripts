[PrintTextModified Text:くっ、敵はまだ残っているということか……！|#0205Adv06_Leia001| AuthorId:Leia RevealSpeed:1 WaitForInput:true Wait:true]

@AnimateActorExtended ActorIds:MainBackground-Front,Leia-Front Loop:false
