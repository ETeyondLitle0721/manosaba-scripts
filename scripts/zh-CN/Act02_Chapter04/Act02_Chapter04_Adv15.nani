[PrintTextModified Text:——这点小事，其实你早就明白了吧？|#0204Adv15_Yuki003| AuthorId:Unknown RevealSpeed:1 WaitForInput:true Wait:true]

@ResetText
@ModifyCharacterExtended Lazy:false IdAndAppearance:Hiro.Fearful1,ArmR13,ArmL13

