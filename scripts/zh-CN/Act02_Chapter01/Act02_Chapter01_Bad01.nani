@ModifyCharacterExtended Lazy:false IdAndAppearance:Leia.Surprised1

[PrintTextModified Text:唔……！|#0201Bad01_Leia010| AuthorId:Leia RevealSpeed:1 WaitForInput:true Wait:true]

@ResetText
