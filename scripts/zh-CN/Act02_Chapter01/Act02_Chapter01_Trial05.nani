@ModifyCharacterExtended Lazy:false IdAndAppearance:Hanna.Default,ArmR2,ArmL2,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open,Angle01/Head01/Facial01/Mouth01>Mouth01_Smile_Open
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Hanna Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"我没有离开房间<br>这一点，<br>可可、米莉亚<br>还有蕾雅<br>都<link=\"Objection_02_01_05_02\">可以作证</link>！|#0201Trial05_Hanna002|" RevealSpeed:1 ScenePosition:70,50 Roll:4

