[PrintTextModified Text:典狱长……？看守……？|#0201Adv03_Ema006| AuthorId:Ema RevealSpeed:1 WaitForInput:true Wait:true]

; ずるずる引きずる音
@PlaySfxModified SfxPath:Sfx_5 Volume:1 Loop:false FadeInDuration:0

