; トラウマシーンここまで
; ========================================
@ResetText
@ModifyBackgroundExtended Id:Stills Rotation:,,0 Scale:{g_backgroundDefaultScale} Duration:0 Lazy:false ScenePosition:50,50 AppearanceAndTransition:440_12 SubId:Middle
