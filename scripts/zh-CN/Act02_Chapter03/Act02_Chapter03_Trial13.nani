; ボス演出
@ResetText
@ModifyCharacterExtended Duration:0 Lazy:false IdAndAppearance:Hiro.Normal2,ArmR6,ArmL3,Eyes2_Angry_Open2,Mouth2_Determined_Open2
@ModifyPerspectiveStageCamera Index:1 Height:5.6 Rotation:"0,{ (8 / courtStandCount * 360)},0" Distance:12 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:1 Rotation:"0,{ (8.1 / courtStandCount * 360)},0" Duration:1 EaseName:OutQuad
@ShowPerspectiveStageScreen Index:1
@Wait WaitMode:1.5

@ResetText
@ModifyCharacterExtended Duration:0 Lazy:false IdAndAppearance:Noah.Default,ArmR1,ArmL5,Angle01/Facial/Eyes>Eyes_Uncomfortable_Open,Angle01/Facial/Mouth>Mouth_Smile_Open02
@ModifyPerspectiveStageCamera Index:0 Height:5.6 Rotation:"0,{ (7 / courtStandCount * 360)},0" Distance:12 Duration:0
@WaitForNextFrame

