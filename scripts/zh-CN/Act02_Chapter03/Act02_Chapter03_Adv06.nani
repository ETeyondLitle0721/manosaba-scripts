@HideAllCharacters Lazy:false
@ModifyCharacterExtended Lazy:false ScenePosition:30 IdAndAppearance:AnAn
@ModifyCharacterExtended Lazy:false ScenePosition:70 IdAndAppearance:Noah.Pensive1

[PrintTextModified Text:艾玛吗？<br>欸，为什么这么说？|#0203Adv06_Noah013| AuthorId:Noah RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false IdAndAppearance:AnAn.Pensive

[PrintTextModified Text:因为……|#0203Adv06_AnAn014| AuthorId:AnAn RevealSpeed:1 WaitForInput:true Wait:true]

