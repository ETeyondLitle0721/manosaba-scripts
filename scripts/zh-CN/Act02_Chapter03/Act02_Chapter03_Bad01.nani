@ModifyCharacterExtended Lazy:false IdAndAppearance:AnAn.Flushed1

[PrintTextModified Text:……要是你们想看，<br>吾辈也不是不能给你们看……|#0203Bad01_AnAn002| AuthorId:AnAn RevealSpeed:1 WaitForInput:true Wait:true]

