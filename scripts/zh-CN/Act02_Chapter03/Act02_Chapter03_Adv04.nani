@GosubResetWitchBook Path:System/System_ResetWitchBook IsDebugDirectJump:{isDebugDirectJump}
@Gosub Path:System/System_Subroutine.BeginAdv

@ModifyBackgroundExtended TintColor:#000000 Duration:1.2 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

# Scene2-3-4

; ========================================
; ●シーン2‐3‐4
; ========================================

; ========================================
; □マップイベント用分岐
; ========================================

; ========================================
; 【ＭＡＰイベント】牢屋敷マップ
; 中庭＞シーン2‐3‐5
; ノアのアトリエ＞シーン2‐3‐6
; 娯楽室＞シーン2‐3‐7
; 牢屋敷前＞シーン2‐3‐8
; ※全てのＭＡＰイベントを選択したら終了。
; 選択済みの場所は消していってください。
; ========================================

@BeginIf Expression:"chosenAreaFlag == 15"
    @SetCustomVariable Expression:"chosenAreaFlag = 0"
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter03/Act02_Chapter03_Adv09 SoftReset:true

@ChoiceMapArea CategoryNames:Courtyard,NoahStudio,RecreationRoom,PrisonEntrance Back:false Global:false MapAreaNames:Courtyard,NoahStudio,RecreationRoom,PrisonEntrance FlagVariableName:chosenAreaFlag

@BeginIf Expression:"chosenAreaId==\"Courtyard\""
    @SetCustomVariableAsFlag Number:0 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter03/Act02_Chapter03_Adv05 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"NoahStudio\""
    @SetCustomVariableAsFlag Number:1 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter03/Act02_Chapter03_Adv06 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"RecreationRoom\""
    @SetCustomVariableAsFlag Number:2 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter03/Act02_Chapter03_Adv07 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"PrisonEntrance\""
    @SetCustomVariableAsFlag Number:3 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act02_Chapter03/Act02_Chapter03_Adv08 SoftReset:true

@Stop

