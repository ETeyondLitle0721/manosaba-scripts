@Wait WaitMode:1.2

[PrintTextModified Text:我我我、我的名字是、冰、冰、冰……<br>冰上、梅露露……|#0203Adv01_Meruru001| AuthorId:Meruru RevealSpeed:1 WaitForInput:true Wait:true]

@ResetText
@ModifyBackgroundExtended TintColor:#000000FF Duration:0.5 Lazy:false AppearanceAndTransition:SolidColor.Custom SubId:Overlay
