[PrintTextModified Text:随后犹如受到重力的牵引一般，<br>慢慢地垂直落下。|#0203Adv10_Narrative027| RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyBackgroundExtended TintColor:#000000FF Duration:0.2 Lazy:false AppearanceAndTransition:SolidColor.Custom SubId:Overlay
@Wait WaitMode:0.2
@ModifyCharacterExtended Scale:0.31 Duration:0 Lazy:false ScenePosition:,55 IdAndAppearance:AnAn.Fearful1
@ModifyBackgroundExtended TintColor:#00000000 Duration:0.2 Lazy:false AppearanceAndTransition:SolidColor.Custom SubId:Overlay
