@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.3
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right
[PrintTextModified Text:是呢。|#0206Trial06_Yuki023| AuthorId:Yuki RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.6
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right
[PrintTextModified Text:准确来说，是我和人类的合作？|#0206Trial06_Yuki024| AuthorId:Yuki RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.13
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Right
