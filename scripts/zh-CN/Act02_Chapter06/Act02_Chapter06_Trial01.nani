@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.11
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:……处决全人类。|#0206Trial01_Yuki003| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Yuki.7
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Yuki Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"这是<link=\"Objection_02_06_01_02\">既定事项</link>。|#0206Trial01_Yuki004|" RevealSpeed:1 ScenePosition:70,50 Roll:4

