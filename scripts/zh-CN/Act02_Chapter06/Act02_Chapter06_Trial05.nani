@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmL11,ArmR12,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Pensive_Middle
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Ema Composition:Center
