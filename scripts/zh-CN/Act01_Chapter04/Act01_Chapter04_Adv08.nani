@GosubResetWitchBook Path:System/System_ResetWitchBook IsDebugDirectJump:{isDebugDirectJump}
@Gosub Path:System/System_Subroutine.BeginAdv

@ModifyBackgroundExtended TintColor:#000000 Duration:1.2 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

# Scene1-4-8

; ========================================
; ●シーン1‐4-8
; ========================================

; ========================================
; マップイベント用分岐
; ========================================

; ========================================
; 【ＭＡＰイベント】牢屋敷見取り図
; 殺人現場＞シーン1‐4‐9
; 裁判所前通路＞シーン1‐4‐10
; 地下通路＞シーン1-4‐11
; ※全てのＭＡＰイベントを選択したら終了。
; 選択済みの場所は消していってください。
; 滝口注・4-10の情報が4-9前提になっているので、最初に4-9としてください（そのあと、4-10と4-11の選択としてください）
; ========================================

@BeginIf Expression:"chosenAreaFlag == 7"
    @SetCustomVariable Expression:"chosenAreaFlag = 0"
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter04/Act01_Chapter04_Adv12 SoftReset:true

@ChoiceMapArea CategoryNames:Courtroom,CourtroomHallway,BasementHallway Back:false Global:false MapAreaNames:Courtroom,CourtroomHallway,BasementHallway FlagVariableName:chosenAreaFlag

@BeginIf Expression:"chosenAreaId==\"Courtroom\""
    @SetCustomVariableAsFlag Number:0 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter04/Act01_Chapter04_Adv09 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"CourtroomHallway\""
    @SetCustomVariableAsFlag Number:1 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter04/Act01_Chapter04_Adv10 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"BasementHallway\""
    @SetCustomVariableAsFlag Number:2 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter04/Act01_Chapter04_Adv11 SoftReset:true

@Stop

