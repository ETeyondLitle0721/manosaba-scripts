[PrintTextModified Text:艾玛挣脱玛格的阻拦，<br>朝梅露露跑去。|#0105Bad01_Narrative001| RevealSpeed:1 WaitForInput:true Wait:true]

@HideActors ActorIds:Margo Lazy:false
