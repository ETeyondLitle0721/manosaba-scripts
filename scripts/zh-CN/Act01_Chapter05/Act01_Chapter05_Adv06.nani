[PrintTextModified Text:怎样，梅露露。我说得对吗？|#0105Adv06_Margo008| AuthorId:Margo RevealSpeed:1 WaitForInput:true Wait:true]

@AnimateActorExtended ActorIds:MainBackground-Middle,Margo-Middle Loop:false
