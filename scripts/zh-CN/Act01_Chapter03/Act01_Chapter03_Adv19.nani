@GosubResetWitchBook Path:System/System_ResetWitchBook IsDebugDirectJump:{isDebugDirectJump}
@Gosub Path:System/System_Subroutine.BeginAdv

@ModifyBackgroundExtended TintColor:#000000 Duration:1.2 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

# Scene1-3-19

; ========================================
; ●シーン1‐3-19
; ========================================

; ========================================
; マップイベント用分岐
; ========================================

; ========================================
; 【ＭＡＰイベント】牢屋敷マップ
; 殺人現場＞シーン1‐3‐20
; 水精の間＞シーン1‐3‐21
; 地精の間＞シーン1‐3‐22
; ゲストハウス＞シーン1‐3‐23
; 倉庫＞シーン1-3-24
; 医務室＞シーン1‐3‐25
; ※全てのＭＡＰイベントを選択したら終了。
; 選択済みの場所は消していってください。
; ========================================

@BeginIf Expression:"chosenAreaFlag == 63"
    @SetCustomVariable Expression:"chosenAreaFlag = 0"
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv26 SoftReset:true

@ChoiceMapArea CategoryNames:ChamberSalamander,ChamberUndine,ChamberGnome,FrontGuesthouse,Warehouse,Infirmary Back:false Global:false MapAreaNames:ChamberSalamander,ChamberUndine,ChamberGnome,FrontGuesthouse,Warehouse,Infirmary FlagVariableName:chosenAreaFlag

@BeginIf Expression:"chosenAreaId==\"ChamberSalamander\""
    @SetCustomVariableAsFlag Number:0 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv20 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"ChamberUndine\""
    @SetCustomVariableAsFlag Number:1 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv21 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"ChamberGnome\""
    @SetCustomVariableAsFlag Number:2 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv22 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"FrontGuesthouse\""
    @SetCustomVariableAsFlag Number:3 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv23 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"Warehouse\""
    @SetCustomVariableAsFlag Number:4 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv24 SoftReset:true

@BeginIf Expression:"chosenAreaId==\"Infirmary\""
    @SetCustomVariableAsFlag Number:5 VariableName:chosenAreaFlag
    @Gosub Path:System/System_Subroutine.EndAdv
    @GotoModified Path:Act01_Chapter03/Act01_Chapter03_Adv25 SoftReset:true

@Stop

