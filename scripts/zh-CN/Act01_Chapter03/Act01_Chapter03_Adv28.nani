@Wait WaitMode:0.3

[PrintTextModified Text:礼物……？|#0103Adv28_Ema002| AuthorId:Ema RevealSpeed:1 WaitForInput:true Wait:true]

@HidePrinter
@ModifyCharacterExtended Lazy:false ScenePosition:30 IdAndAppearance:Hanna.Surprised1
