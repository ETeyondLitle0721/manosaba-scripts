@ModifyCharacterExtended Lazy:false ScenePosition:40 IdAndAppearance:Coco.Angry1

[PrintTextModified Text:啧，别烦我！！|#0202Adv19_Coco020| AuthorId:Coco RevealSpeed:1 WaitForInput:true Wait:true]

