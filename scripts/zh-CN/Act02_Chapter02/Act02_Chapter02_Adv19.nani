[PrintTextModified Text:我猜，你是怕她用在别人身上<br>才想先去阻止她吧。|#0202Adv19_Hiro009| AuthorId:Hiro RevealSpeed:1 WaitForInput:true Wait:true]

@AnimateActorExtended ActorIds:MainBackground-Front,Hiro-Front Loop:false
