[PrintTextModified Text:……【杀死魔女的药】吗。|#0202Adv19_Hiro006| AuthorId:Hiro RevealSpeed:1 WaitForInput:true Wait:true]

@AnimateActorExtended ActorIds:MainBackground-Front,Hiro-Front Loop:false
