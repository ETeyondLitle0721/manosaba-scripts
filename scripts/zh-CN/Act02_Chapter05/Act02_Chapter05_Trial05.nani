@GosubResetWitchBook Path:System/System_ResetWitchBook Version:2

@BeginIf Expression:isDebugDirectJump
    @Gosub Path:Act02_Chapter05/Act02_Chapter05_TrialInit
    @HidePerspectiveStageScreen Index:1 Duration:0 Reset:true
    @ModifyBackgroundExtended TintColor:#000000 Duration:0 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay

@SetTrialTimer Time:900
@HideUI UINames:ControlPanel AllowToggle:false
@ShowUI UINames:DebateUI

; クリーチャー化初期化
@HideActors ActorIds:Hiro Lazy:false
@ModifyCharacterExtended Position:{hiroPositionX},{characterPositionY},{hiroPositionZ} Rotation:,{hiroRotationY} Scale:{characterScale},{characterScale},1 Duration:0 Lazy:false IdAndAppearance:CreatureHiro.2

@HideActors ActorIds:Meruru Lazy:false
@ModifyCharacterExtended Position:{meruruPositionX},{characterPositionY},{meruruPositionZ} Rotation:,{meruruRotationY} Scale:{characterScale},{characterScale},1 Duration:0 Lazy:false IdAndAppearance:CreatureMeruru.3-5

; ==============================================================================
; MARK: 10-5: 💬 【蓮見レイア】
; ==============================================================================
; ＠ト書き▼議論10-5【蓮見レイア】
; 議論開始カットイン
; BGM変更：HirO（Voなし）
@PlayBgm BgmPath:Bgm_37_1_Loop IntroBgmPath:Bgm_37_1_Intro Volume:1 Loop:true FadeInDuration:0

; ボス演出
@ResetText
@ModifyCharacterExtended Duration:0 Lazy:false IdAndAppearance:CreatureHiro.2
@ModifyPerspectiveStageCamera Index:1 Height:5.6 Rotation:"0,{ (8 / courtStandCount * 360)},0" Distance:12 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:1 Rotation:"0,{ (8.1 / courtStandCount * 360)},0" Duration:1 EaseName:OutQuad
@ShowPerspectiveStageScreen Index:1
@Wait WaitMode:1.5

@ResetText
@ModifyCharacterExtended Duration:0 Lazy:false IdAndAppearance:Leia.Default,ArmR8,ArmL4,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Angry_Closed,Angle01/Facial/Sweat>Sweat01
@ModifyPerspectiveStageCamera Index:0 Height:5.6 Rotation:"0,{ (3 / courtStandCount * 360)},0" Distance:12 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:0 Rotation:"0,{ (2.9 / courtStandCount * 360)},0" Duration:1 EaseName:OutQuad
@HidePerspectiveStageScreen Index:1 Reset:true
@Wait WaitMode:1.5

# Judge10-5-1

@Gosub Path:System/System_Subroutine.BeginDebate-First
@Gosub Path:System/System_Subroutine.BeginDebate-Effect
@Gosub Path:System/System_Subroutine.BeginDebate-Last
@ChangeTrialPauseMode Enable:false ProcessTimer:true

@HidePerspectiveStageScreen Index:1 Reset:true

@ModifyCharacterExtended Lazy:false IdAndAppearance:CreatureHiro.9
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Hiro Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:你为了受人瞩目，<br>而持续进行着活动……|#0205Trial05_Hiro001| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:CreatureHiro.8
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Hiro Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:无论使出什么手段，<br>都必须永远争到第一<br>才甘心。|#0205Trial05_Hiro002| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Leia.Default,ArmR9,ArmL4,Angle01/Facial/Eyes>Eyes_Fearful_Open,Angle01/Facial/Mouth>Mouth_Yell_Open02,Angle01/Facial/Sweat>Sweat01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Leia Composition:Right RollDirection:Left ZoomLevel:3
