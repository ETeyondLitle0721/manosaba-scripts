@ModifyCharacterExtended Lazy:false IdAndAppearance:Margo.Default,ArmR5,ArmL1,Angle01/Facial/Eyes>Eyes_Smile_Middle,Angle01/Facial/Mouth>Mouth_Pensive_Closed
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Margo Composition:Right
