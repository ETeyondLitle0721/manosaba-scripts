@PlayBgm BgmPath:Bgm_37_1_Loop IntroBgmPath:Bgm_37_1_Intro Volume:1 Loop:true FadeInDuration:0

; ボス演出
@ResetText
@ModifyCharacterExtended Duration:0 Lazy:false IdAndAppearance:CreatureHiro.2
@ModifyPerspectiveStageCamera Index:1 Height:5.6 Rotation:"0,{ (8 / courtStandCount * 360)},0" Distance:12 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:1 Rotation:"0,{ (8.1 / courtStandCount * 360)},0" Duration:1 EaseName:OutQuad
@ShowPerspectiveStageScreen Index:1
@Wait WaitMode:1.5

@ResetText
@ModifyCharacterExtended Duration:0 Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR1,ArmL9,Eyes1_Flushed_Open1,Mouth1_Angry_Closed2,Sweat1_1
@ModifyPerspectiveStageCamera Index:0 Height:5.6 Rotation:"0,{ (10 / courtStandCount * 360)},0" Distance:12 Duration:0
@WaitForNextFrame

@ModifyPerspectiveStageCamera Index:0 Rotation:"0,{ (9.9 / courtStandCount * 360)},0" Duration:1 EaseName:OutQuad
@HidePerspectiveStageScreen Index:1 Reset:true
@Wait WaitMode:1.5

# Judge10-12-1

@Gosub Path:System/System_Subroutine.BeginDebate-First
@Gosub Path:System/System_Subroutine.BeginDebate-Effect
@Gosub Path:System/System_Subroutine.BeginDebate-Last
@ChangeTrialPauseMode Enable:false ProcessTimer:true

@HidePerspectiveStageScreen Index:1 Reset:true

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR1,ArmL1,Eyes1_Normal_Open2,Mouth1_Normal_Open1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:来到这里之后，<br>我稍微幻视到了一些<br>这座岛过去的景象……|#0205Trial12_Nanoka001| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR1,ArmL1,Eyes1_Normal_Open2,Mouth1_Normal_Closed1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:虽然我当时<br>并不确切明白<br>那些景象<br>有什么含义……|#0205Trial12_Nanoka002| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR3,ArmL1,Eyes1_Angry_Open1,Mouth1_Angry_Open1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:但结合你的话来看，<br>我明白了<br>那就是大魔女的力量。|#0205Trial12_Nanoka003| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR3,ArmL1,Eyes1_Normal_Closed1,Mouth1_Angry_Open1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"大魔女的力量很强大，<br>你根本<br>无法<link=\"Objection_02_05_12_01\">战胜</link>……|#0205Trial12_Nanoka004|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmL5,Angle01/ArmR-,Eyes1_Normal_Closed1,Mouth1_Smile_Open1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:……这也很正常。<br>毕竟<br>我们的魔法<br>就是她赋予的。|#0205Trial12_Nanoka005| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmL5,Angle01/ArmR-,Eyes1_Pensive_Open1,Mouth1_Smile_Closed1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"复制品是<br><link=\"Objection_02_05_12_02\">打不赢</link>原版的。<br>这是理所当然的事实。|#0205Trial12_Nanoka006|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR6,ArmL8,Eyes1_Flushed_Open1,Mouth1_Normal_Open1,Sweat1_1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Hiro Composition:Right RollDirection:Left ZoomLevel:3
@PrintDebateText Text:我的职责正是<br>想办法去解决这个问题。|#0205Trial12_Hiro001| RevealSpeed:1 ScenePosition:30,50 Roll:-4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR6,ArmL8,Eyes1_Flushed_Open1,Mouth1_Normal_Open1,Sweat1_1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:……够了，放弃吧。|#0205Trial12_Nanoka007| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR6,ArmL8,Eyes1_Flushed_Open1,Mouth1_Normal_Open1,Sweat1_1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:你根本<br>没什么战斗力，<br>怎么可能<br>战胜大魔女。|#0205Trial12_Nanoka008| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR6,ArmL8,Eyes1_Angry_Closed1,Mouth1_Normal_Open1,Sweat1_1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"这连战斗都算不上。<br>纯粹是<link=\"Objection_02_05_12_03\">白白送死</link>而已。|#0205Trial12_Nanoka009|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR6,ArmL3,Eyes1_Uncomfortable_Open1,Mouth1_Normal_Closed1,Sweat1_1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:我为了战胜大魔女，<br>做了充分的准备……|#0205Trial12_Nanoka010| RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Nanoka.Normal1,ArmR6,ArmL3,Eyes1_Normal_Open3,Mouth1_Normal_Open1,Sweat1_1
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Nanoka Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"……请你不要<br>把我拖进你的<br><link=\"Objection_02_05_12_04\">赌局</link>之中。|#0205Trial12_Nanoka011|" RevealSpeed:1 ScenePosition:70,50 Roll:4


