@ModifyCharacterExtended Lazy:false IdAndAppearance:Noah.Default,ArmR6,Angle01/ArmL>ArmL06,Angle01/Facial/Eyes>Eyes_Angry_Open,Angle01/Facial/Mouth>Mouth_Confused_Open,Angle01/Facial/Sweat>Sweat01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Noah Composition:Left RollDirection:Right ZoomLevel:3
@PrintDebateText Text:"因为……<br>谁都<link=\"Objection_02_05_07_01\">不给看</link>……|#0205Trial07_Noah005|" RevealSpeed:1 ScenePosition:70,50 Roll:4

@ModifyCharacterExtended Lazy:false IdAndAppearance:Noah.Default,ArmR4,Angle01/ArmL>ArmL06,Angle01/Facial/Eyes>Eyes_Pensive_Open,Angle01/Facial/Mouth>Mouth_Confused_Open,Angle01/Facial/Sweat>Sweat01
@GosubToModifyPerspectiveStageCamera Index:0 LookCharacterId:Noah Composition:Left RollDirection:Right ZoomLevel:3
