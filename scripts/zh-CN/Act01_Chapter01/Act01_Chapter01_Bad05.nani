[PrintTextModified Text:因为我们，把她丢下了……<br>如果我有更强大的力量……！|#0101Bad05_Hanna019| AuthorId:Hanna RevealSpeed:1 WaitForInput:true Wait:true]

@HideAllCharacters Lazy:false
@ModifyCharacterExtended Lazy:false ScenePosition:50 IdAndAppearance:Ema.Pensive1

