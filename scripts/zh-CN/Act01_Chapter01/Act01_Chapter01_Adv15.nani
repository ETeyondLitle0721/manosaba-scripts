; 演出：アリサカットイン
; ========================================

@HidePrinter
@SpawnExtended Path:MaskingRectangle Params:40,200,true,0.3,#000000 ScenePosition:20,50 Rotation:,,0 SubId:Front
@ModifyBackgroundExtended Rotation:,,0 Scale:1.8 Lazy:false ScenePosition:-20,36 AppearanceAndTransition:21_1 SubId:Front
@ModifyCharacterExtended Rotation:,,0 Scale:1.8 Lazy:false ScenePosition:20,32 IdAndAppearance:Alisa.Angry1,Option-ArmL-Off SubId:Front
