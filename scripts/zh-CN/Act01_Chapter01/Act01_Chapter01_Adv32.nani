; ========================================
; ＞『娯楽室』を選択
; ========================================

; ========================================
; [bgm Bgm_005_001_Loop]
; ========================================

@ModifyBackgroundExtended Scale:{g_backgroundDefaultScale} Duration:0 Lazy:false AppearanceAndTransition:11_1
@ModifyBackgroundExtended TintColor:#000000 Duration:1.2 Lazy:false AppearanceAndTransition:Transparent SubId:Overlay
