@Wait WaitMode:0.9

[PrintTextModified Text:"按照地图的位置，<br>这里是【<ruby=\"SALAMANDER\">火精</ruby>之室】……？|#0101Adv18_Ema007|" AuthorId:Ema RevealSpeed:1 WaitForInput:true Wait:true]

