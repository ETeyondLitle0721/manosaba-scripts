[PrintTextModified Text:你的说话口吻，是你爸妈教的对吗？|#0101Adv04_Leia003| AuthorId:Leia RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false ScenePosition:70 IdAndAppearance:Hanna.Angry1

