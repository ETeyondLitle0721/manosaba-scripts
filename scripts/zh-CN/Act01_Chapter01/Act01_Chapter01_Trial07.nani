@ResetText
@ModifyCharacterExtended Lazy:false IdAndAppearance:Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Normal_Open2,Mouth1_Normal_Open2
@GosubToSplitPerspectiveStageScreens Index:1 LookCharacterId:Meruru Composition:Left RollDirection:Right
@Wait WaitMode:0.2

[PrintTextModified Text:……总感觉米莉亚小姐她<br>有些不太自信呢……|#0101Trial07_Meruru001| AuthorId:Meruru RevealSpeed:1 WaitForInput:true Wait:true]

@ModifyCharacterExtended Lazy:false IdAndAppearance:Meruru.Normal1,ArmR1_1,ArmL8,Eyes1_Normal_Open2,Mouth1_Normal_Open2

[PrintTextModified Text:说不定……<br>可可的推理漏洞就在其中……|#0101Trial07_Meruru002| AuthorId:Meruru RevealSpeed:1 WaitForInput:true Wait:true]

@HidePerspectiveStageScreen Index:1 Reset:true
@Wait WaitMode:0.3

@ModifyCharacterExtended Lazy:false IdAndAppearance:Ema.Default,ArmR3,ArmL1,Angle01/Head01/Facial01/Eyes01>Eyes01_Normal_Open02,Angle01/Head01/Facial01/Mouth01>Mouth01_Determined_Closed,Angle01/Head01/Facial01/Sweat01>Sweat01_01

[PrintTextModified Text:"（有没有证物可以证明<br>　可可的推理不对呢……？）|#0101Trial07_Ema002|" AuthorId:Ema RevealSpeed:1 WaitForInput:true Wait:true]

@GotoModified Path:.Judge1-7-1

